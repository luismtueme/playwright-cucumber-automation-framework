{
  "name": "playwright-cucumber-framework",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright + Cucumber test automation framework: UI, API and database testing with Allure reporting",
  "license": "MIT",
  "author": "luismtueme",
  "keywords": [
    "playwright",
    "cucumber",
    "automation",
    "testing"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "npm run clean && npm run test:playwright && npm run test:cucumber",
    "test:playwright": "playwright test",
    "test:cucumber": "cucumber-js",
    "test:unit": "node --test \"unit/*.test.js\"",
    "check": "node utils/validateSteps.js && playwright test --list",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p .",
    "format": "prettier --write . && eslint --fix .",
    "clean": "node utils/allureMetadata.js clean",
    "demo": "node demo-app/server.js",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.1",
    "@types/node": "^22.7.6",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "allure-playwright": "^3.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "mysql2": "^3.11.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
